{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beac-sportnap",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "TournamentRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TournamentRoom"]
    }
  ],

  "kv_namespaces": [
    {
      "binding": "ARCHIVE"
    }
  ],

  "vars": {
    "EVENT_ID": "beac-sportnap-volleyball-beta"
  }
}
